[{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279","repository_url":"https://api.github.com/repos/alik0211/mtproto-core","labels_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279/labels{/name}","comments_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279/comments","events_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279/events","html_url":"https://github.com/alik0211/mtproto-core/issues/279","id":1682617863,"node_id":"I_kwDODViEZ85kSrYH","number":279,"title":"messages.getAllChats always retrun INPUT_METHOD_INVALID_2271179966_*","user":{"login":"bigbigsir","id":30718335,"node_id":"MDQ6VXNlcjMwNzE4MzM1","avatar_url":"https://avatars.githubusercontent.com/u/30718335?v=4","gravatar_id":"","url":"https://api.github.com/users/bigbigsir","html_url":"https://github.com/bigbigsir","followers_url":"https://api.github.com/users/bigbigsir/followers","following_url":"https://api.github.com/users/bigbigsir/following{/other_user}","gists_url":"https://api.github.com/users/bigbigsir/gists{/gist_id}","starred_url":"https://api.github.com/users/bigbigsir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bigbigsir/subscriptions","organizations_url":"https://api.github.com/users/bigbigsir/orgs","repos_url":"https://api.github.com/users/bigbigsir/repos","events_url":"https://api.github.com/users/bigbigsir/events{/privacy}","received_events_url":"https://api.github.com/users/bigbigsir/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":true,"assignees":[],"milestone":null,"comments":21,"created_at":"2023-04-25T07:44:32Z","updated_at":"2023-06-02T19:01:08Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"layer: 139\r\n\r\n<img width=\"547\" alt=\"image\" src=\"https://user-images.githubusercontent.com/30718335/234210451-143e0e90-3c77-4ed1-b4f4-50d03e86e96b.png\">\r\n<img width=\"584\" alt=\"image\" src=\"https://user-images.githubusercontent.com/30718335/234208815-c2243782-c635-4b68-9544-7146ac78c33e.png\">\r\n<img width=\"595\" alt=\"image\" src=\"https://user-images.githubusercontent.com/30718335/234208850-4888835d-f7ae-4f0e-8666-a0e3d86ab86e.png\">\r\n\r\nIs there anyone who can help me？","closed_by":null,"reactions":{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/279/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177","repository_url":"https://api.github.com/repos/alik0211/mtproto-core","labels_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177/labels{/name}","comments_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177/comments","events_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177/events","html_url":"https://github.com/alik0211/mtproto-core/issues/177","id":856180286,"node_id":"MDU6SXNzdWU4NTYxODAyODY=","number":177,"title":"How to authenticate?","user":{"login":"Argon007","id":40138759,"node_id":"MDQ6VXNlcjQwMTM4NzU5","avatar_url":"https://avatars.githubusercontent.com/u/40138759?v=4","gravatar_id":"","url":"https://api.github.com/users/Argon007","html_url":"https://github.com/Argon007","followers_url":"https://api.github.com/users/Argon007/followers","following_url":"https://api.github.com/users/Argon007/following{/other_user}","gists_url":"https://api.github.com/users/Argon007/gists{/gist_id}","starred_url":"https://api.github.com/users/Argon007/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Argon007/subscriptions","organizations_url":"https://api.github.com/users/Argon007/orgs","repos_url":"https://api.github.com/users/Argon007/repos","events_url":"https://api.github.com/users/Argon007/events{/privacy}","received_events_url":"https://api.github.com/users/Argon007/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":true,"assignees":[],"milestone":null,"comments":18,"created_at":"2021-04-12T17:12:45Z","updated_at":"2023-06-26T17:58:39Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hello,\r\n\r\nFairly new to Node and Telegram so this is a bit overwhelming for me. I've created an \"api.js\" file and copied the content of your api.js file into it (my api and api_hash are configured in the file).\r\n\r\nNext i've created the \"example.js\" file like this:\r\n\r\n```\r\nvar api = require('./api.js');\r\n\r\n(async () => {\r\n    const user = await getUser();\r\n  \r\n    const phone = '+3xxxxxxxx';\r\n    const code = 'XXXXX';\r\n  \r\n    if (!user) {\r\n      const { phone_code_hash } = await sendCode(phone);\r\n  \r\n      try {\r\n        const signInResult = await signIn({\r\n          code,\r\n          phone,\r\n          phone_code_hash,\r\n        });\r\n  \r\n        if (signInResult._ === 'auth.authorizationSignUpRequired') {\r\n          await signUp({\r\n            phone,\r\n            phone_code_hash,\r\n          });\r\n        }\r\n      } catch (error) {\r\n        if (error.error_message !== 'SESSION_PASSWORD_NEEDED') {\r\n          console.log(`error:`, error);\r\n  \r\n          return;\r\n        }\r\n  \r\n        // 2FA\r\n  \r\n        const password = 'MY_PERSONAL_2FA_CODE';\r\n  \r\n        const { srp_id, current_algo, srp_B } = await getPassword();\r\n        const { g, p, salt1, salt2 } = current_algo;\r\n  \r\n        const { A, M1 } = await api.mtproto.crypto.getSRPParams({\r\n          g,\r\n          p,\r\n          salt1,\r\n          salt2,\r\n          gB: srp_B,\r\n          password,\r\n        });\r\n  \r\n        const checkPasswordResult = await checkPassword({ srp_id, A, M1 });\r\n      }\r\n    }\r\n  })();\r\n\r\nasync function getUser() {\r\n    try {\r\n      const user = await api.call('users.getFullUser', {\r\n        id: {\r\n          _: 'inputUserSelf',\r\n        },\r\n      });\r\n  \r\n      return user;\r\n    } catch (error) {\r\n      return null;\r\n    }\r\n  }\r\n\r\n  function sendCode(phone) {\r\n    return api.call('auth.sendCode', {\r\n      phone_number: phone,\r\n      settings: {\r\n        _: 'codeSettings',\r\n      },\r\n    });\r\n  }\r\n\r\n  function signIn({ code, phone, phone_code_hash }) {\r\n    return api.call('auth.signIn', {\r\n      phone_code: code,\r\n      phone_number: phone,\r\n      phone_code_hash: phone_code_hash,\r\n    });\r\n  }\r\n\r\n  function signUp({ phone, phone_code_hash }) {\r\n    return api.call('auth.signUp', {\r\n      phone_number: phone,\r\n      phone_code_hash: phone_code_hash,\r\n      first_name: 'MTProto',\r\n      last_name: 'Core',\r\n    });\r\n  }\r\n\r\n  function getPassword() {\r\n    return api.call('account.getPassword');\r\n  }\r\n\r\n  function checkPassword({ srp_id, A, M1 }) {\r\n    return api.call('auth.checkPassword', {\r\n      password: {\r\n        _: 'inputCheckPasswordSRP',\r\n        srp_id,\r\n        A,\r\n        M1,\r\n      },\r\n    });\r\n  }\r\n```\r\nSo I entered my phone number, but can't write anything yet for the \"code\" variable since I didn't receive the code yet. I also changed the 2FA code to my personal 2FA string. Once I start example.js I get:\r\n\r\n> users.getFullUser error: {\r\n>   _: 'mt_rpc_error',\r\n>   error_code: 401,\r\n>   error_message: 'SESSION_PASSWORD_NEEDED'\r\n> }\r\n> auth.sendCode error: { _: 'mt_rpc_error', error_code: 500, error_message: 'AUTH_RESTART' }\r\n> (node:3624408) UnhandledPromiseRejectionWarning: #<Object>\r\n> (Use `node --trace-warnings ...` to show where the warning was created)\r\n> (node:3624408) UnhandledPromiseRejectionWarning: Unhandled promise rejection. This error originated either by throwing inside of an async function without a catch block, or by rejecting a promise which was not handled with .catch(). To terminate the node process on unhandled promise rejection, use the CLI flag `--unhandled-rejections=strict` (see https://nodejs.org/api/cli.html#cli_unhandled_rejections_mode). (rejection id: 3)\r\n> (node:3624408) [DEP0018] DeprecationWarning: Unhandled promise rejections are deprecated. In the future, promise rejections that are not handled will terminate the Node.js process with a non-zero exit code\r\n\r\nCan anyone point me in the right direction how to get authenticated?\r\n\r\nThanks!\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/177/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229","repository_url":"https://api.github.com/repos/alik0211/mtproto-core","labels_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229/labels{/name}","comments_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229/comments","events_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229/events","html_url":"https://github.com/alik0211/mtproto-core/pull/229","id":1083812173,"node_id":"PR_kwDODViEZ84wCA95","number":229,"title":"Add cloudflare environment.","user":{"login":"Legend1991","id":2713628,"node_id":"MDQ6VXNlcjI3MTM2Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/2713628?v=4","gravatar_id":"","url":"https://api.github.com/users/Legend1991","html_url":"https://github.com/Legend1991","followers_url":"https://api.github.com/users/Legend1991/followers","following_url":"https://api.github.com/users/Legend1991/following{/other_user}","gists_url":"https://api.github.com/users/Legend1991/gists{/gist_id}","starred_url":"https://api.github.com/users/Legend1991/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Legend1991/subscriptions","organizations_url":"https://api.github.com/users/Legend1991/orgs","repos_url":"https://api.github.com/users/Legend1991/repos","events_url":"https://api.github.com/users/Legend1991/events{/privacy}","received_events_url":"https://api.github.com/users/Legend1991/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":true,"assignees":[],"milestone":null,"comments":14,"created_at":"2021-12-18T11:28:19Z","updated_at":"2024-03-21T21:06:04Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/alik0211/mtproto-core/pulls/229","html_url":"https://github.com/alik0211/mtproto-core/pull/229","diff_url":"https://github.com/alik0211/mtproto-core/pull/229.diff","patch_url":"https://github.com/alik0211/mtproto-core/pull/229.patch","merged_at":null},"body":"Cloudflare has its own way to work with WebSockets. Turns out to make it work you have to handle the handshaking process yourself using HTTP Upgrade mechanism. Actually it is the only difference from browser implementation.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/229/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148","repository_url":"https://api.github.com/repos/alik0211/mtproto-core","labels_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148/labels{/name}","comments_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148/comments","events_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148/events","html_url":"https://github.com/alik0211/mtproto-core/issues/148","id":792284148,"node_id":"MDU6SXNzdWU3OTIyODQxNDg=","number":148,"title":"API messages.sendMultiMedia Always Fails (400 MEDIA_INVALID) for valid media","user":{"login":"mvdicarlo","id":23141042,"node_id":"MDQ6VXNlcjIzMTQxMDQy","avatar_url":"https://avatars.githubusercontent.com/u/23141042?v=4","gravatar_id":"","url":"https://api.github.com/users/mvdicarlo","html_url":"https://github.com/mvdicarlo","followers_url":"https://api.github.com/users/mvdicarlo/followers","following_url":"https://api.github.com/users/mvdicarlo/following{/other_user}","gists_url":"https://api.github.com/users/mvdicarlo/gists{/gist_id}","starred_url":"https://api.github.com/users/mvdicarlo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mvdicarlo/subscriptions","organizations_url":"https://api.github.com/users/mvdicarlo/orgs","repos_url":"https://api.github.com/users/mvdicarlo/repos","events_url":"https://api.github.com/users/mvdicarlo/events{/privacy}","received_events_url":"https://api.github.com/users/mvdicarlo/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":true,"assignees":[],"milestone":null,"comments":10,"created_at":"2021-01-22T20:26:24Z","updated_at":"2022-09-11T02:32:16Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I have been trying to get this particular api method to work (https://core.telegram.org/method/messages.sendMultiMedia).\r\n\r\nI have provided sample code below that I am using to test this behavior. It shouldn't be an issue of the actual file being invalid as if you attempt to send the media using https://core.telegram.org/method/messages.sendMedia it works just fine.\r\n\r\nIt appears to be a bug, but I don't know enough about the protocol implementation to be able to fix it myself.\r\n\r\n```\r\nconst { MTProto } = require(\"@mtproto/core\");\r\nconst readline = require(\"readline\");\r\nconst fs = require(\"fs\");\r\n\r\nconst api_id = \"<app id>\";\r\nconst api_hash = \"<app hash>\";\r\nconst phone_number = \"<phone>\";\r\nconst file = fs.readFileSync(\"test.jpg\"); // assumes under 512kb\r\n\r\n// 1. Create an instance\r\nconst mtproto = new MTProto({\r\n  api_id,\r\n  api_hash,\r\n});\r\n\r\nasync function auth() {\r\n  const send = await mtproto.call(\"auth.sendCode\", {\r\n    phone_number,\r\n    settings: {\r\n      _: \"codeSettings\",\r\n    },\r\n  });\r\n\r\n  const rl = readline.createInterface({\r\n    input: process.stdin,\r\n    output: process.stdout,\r\n  });\r\n\r\n  const code = await new Promise((resolve) => {\r\n    rl.question(\"Code: \", (answer) => {\r\n      rl.close();\r\n      resolve(answer);\r\n    });\r\n  });\r\n\r\n  const authed = await mtproto.call(\"auth.signIn\", {\r\n    phone_code: code,\r\n    phone_number,\r\n    phone_code_hash: send.phone_code_hash,\r\n  });\r\n\r\n  console.log(authed);\r\n}\r\n\r\nasync function getChats() {\r\n  return await mtproto\r\n    .call(\"messages.getAllChats\", {\r\n      except_ids: [],\r\n    })\r\n    .then(({ chats }) => chats);\r\n}\r\n\r\nfunction wait() {\r\n  return new Promise((resolve) => {\r\n    setTimeout(resolve, 2000);\r\n  });\r\n}\r\n\r\nasync function upload(file) {\r\n  const id = Date.now();\r\n  await mtproto.call(\"upload.saveFilePart\", {\r\n    file_id: id,\r\n    file_part: 0,\r\n    bytes: file,\r\n  });\r\n  return id;\r\n}\r\n\r\n// This does all the stuff\r\nasync function run() {\r\n  mtproto.setDefaultDc(\r\n    await mtproto.call(\"help.getNearestDc\").then((result) => {\r\n      return result.nearest_dc;\r\n    })\r\n  );\r\n\r\n  let chats;\r\n  try {\r\n    chats = await getChats();\r\n  } catch {\r\n    await auth();\r\n    chats = await getChats();\r\n  }\r\n\r\n  const chat = chats[0];\r\n  await wait();\r\n  const upl = await upload(file);\r\n  await wait();\r\n\r\n// I AM BROKEN\r\n  const res = await mtproto\r\n    .call(\"messages.sendMultiMedia\", {\r\n      peer: {\r\n        _: \"inputPeerChannel\",\r\n        channel_id: chat.id,\r\n        access_hash: chat.access_hash,\r\n      },\r\n      multi_media: [\r\n        {\r\n          _: \"inputSingleMedia\",\r\n          random_id: Date.now(),\r\n          //   message: \"Hello, World!\",\r\n          media: {\r\n            _: \"inputMediaUploadedPhoto\",\r\n            file: {\r\n              _: \"inputFile\",\r\n              id: upl,\r\n              name: \"test.jpg\",\r\n              parts: 1,\r\n            },\r\n          },\r\n        },\r\n      ],\r\n    })\r\n    .catch((err) => err);\r\n  // UNCOMMENT ME TO SEE THAT messages.sendMedia works correctly.\r\n  //   const res = await mtproto\r\n  //     .call(\"messages.sendMedia\", {\r\n  //       random_id: Date.now(),\r\n  //       peer: {\r\n  //         _: \"inputPeerChannel\",\r\n  //         channel_id: chat.id,\r\n  //         access_hash: chat.access_hash,\r\n  //       },\r\n  //       message: \"Hello, World\",\r\n  //       media: {\r\n  //         _: \"inputMediaUploadedPhoto\",\r\n  //         file: {\r\n  //           _: \"inputFile\",\r\n  //           id: upl,\r\n  //           name: \"test.jpg\",\r\n  //           parts: 1,\r\n  //         },\r\n  //       },\r\n  //     })\r\n  //     .catch((err) => err);\r\n\r\n  console.log(res);\r\n}\r\n\r\nrun()\r\n  .catch(console.error)\r\n  .finally(() => process.exit(0));\r\n\r\nprocess.on(\"unhandledRejection\", console.error);\r\n\r\n```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/148/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/alik0211/mtproto-core/issues/187","repository_url":"https://api.github.com/repos/alik0211/mtproto-core","labels_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/187/labels{/name}","comments_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/187/comments","events_url":"https://api.github.com/repos/alik0211/mtproto-core/issues/187/events","html_url":"https://github.com/alik0211/mtproto-core/pull/187","id":896269131,"node_id":"MDExOlB1bGxSZXF1ZXN0NjQ4Mzk0NjI3","number":187,"title":"Adding react-native environment","user":{"login":"happymaskterriblefate","id":80355384,"node_id":"MDQ6VXNlcjgwMzU1Mzg0","avatar_url":"https://avatars.githubusercontent.com/u/80355384?v=4","gravatar_id":"","url":"https://api.github.com/users/happymaskterriblefate","html_url":"https://github.com/happymaskterriblefate","followers_url":"https://api.github.com/users/happymaskterriblefate/followers","following_url":"https://api.github.com/users/happymaskterriblefate/following{/other_user}","gists_url":"https://api.github.com/users/happymaskterriblefate/gists{/gist_id}","starred_url":"https://api.github.com/users/happymaskterriblefate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/happymaskterriblefate/subscriptions","organizations_url":"https://api.github.com/users/happymaskterriblefate/orgs","repos_url":"https://api.github.com/users/happymaskterriblefate/repos","events_url":"https://api.github.com/users/happymaskterriblefate/events{/pri