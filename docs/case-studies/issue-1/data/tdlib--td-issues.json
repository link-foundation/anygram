/followers","following_url":"https://api.github.com/users/BenWiederhake/following{/other_user}","gists_url":"https://api.github.com/users/BenWiederhake/gists{/gist_id}","starred_url":"https://api.github.com/users/BenWiederhake/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BenWiederhake/subscriptions","organizations_url":"https://api.github.com/users/BenWiederhake/orgs","repos_url":"https://api.github.com/users/BenWiederhake/repos","events_url":"https://api.github.com/users/BenWiederhake/events{/privacy}","received_events_url":"https://api.github.com/users/BenWiederhake/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":18,"created_at":"2020-07-06T14:49:53Z","updated_at":"2026-04-26T15:33:53Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/tdlib/td/pulls/1127","html_url":"https://github.com/tdlib/td/pull/1127","diff_url":"https://github.com/tdlib/td/pull/1127.diff","patch_url":"https://github.com/tdlib/td/pull/1127.patch","merged_at":null},"body":"This significantly speeds up build times for projects which just want to use tdlib as-is.\r\nOn a single core this should cut about 5 minutes; on 4 cores it cuts a bit more than a minute.\r\nAll this for no measurable cost.\r\n\r\nWithout skipping:\r\n```\r\n$ cmake -DCMAKE_BUILD_TYPE=Release -DTD_SKIP_BENCHMARK=OFF -DTD_SKIP_TEST=OFF -DTD_SKIP_TG_CLI=OFF ..\r\n( ... regular output ... )\r\n$ time /usr/bin/time make install -j4 DESTDIR=../../td_destdir\r\n( ... regular output ... )\r\n1414.69user 55.66system 7:01.60elapsed 348%CPU (0avgtext+0avgdata 2752144maxresident)k\r\n0inputs+1210120outputs (0major+21767636minor)pagefaults 0swaps\r\nreal\t7m1,604s\r\nuser\t23m34,699s\r\nsys\t0m55,665s\r\n```\r\n\r\nWith skipping:\r\n```\r\n$ cmake -DCMAKE_BUILD_TYPE=Release -DTD_SKIP_BENCHMARK=ON -DTD_SKIP_TEST=ON -DTD_SKIP_TG_CLI=ON ..\r\n( ... regular output ... )\r\n$ time /usr/bin/time make install -j4 DESTDIR=../../td_destdir\r\n( ... regular output ... )\r\n1118.16user 42.62system 5:56.22elapsed 325%CPU (0avgtext+0avgdata 2751196maxresident)k\r\n0inputs+891912outputs (0major+17310062minor)pagefaults 0swaps\r\nreal\t5m56,230s\r\nuser\t18m38,163s\r\nsys\t0m42,629s\r\n```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/tdlib/td/issues/1127/reactions","total_count":14,"+1":13,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tdlib/td/issues/1127/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/tdlib/td/issues/2696","repository_url":"https://api.github.com/repos/tdlib/td","labels_url":"https://api.github.com/repos/tdlib/td/issues/2696/labels{/name}","comments_url":"https://api.github.com/repos/tdlib/td/issues/2696/comments","events_url":"https://api.github.com/repos/tdlib/td/issues/2696/events","html_url":"https://github.com/tdlib/td/issues/2696","id":2010223184,"node_id":"I_kwDOBug-8c530ZJQ","number":2696,"title":"Could you please make the tag regularly after every update?","user":{"login":"alimd","id":697913,"node_id":"MDQ6VXNlcjY5NzkxMw==","avatar_url":"https://avatars.githubusercontent.com/u/697913?v=4","gravatar_id":"","url":"https://api.github.com/users/alimd","html_url":"https://github.com/alimd","followers_url":"https://api.github.com/users/alimd/followers","following_url":"https://api.github.com/users/alimd/following{/other_user}","gists_url":"https://api.github.com/users/alimd/gists{/gist_id}","starred_url":"https://api.github.com/users/alimd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alimd/subscriptions","organizations_url":"https://api.github.com/users/alimd/orgs","repos_url":"https://api.github.com/users/alimd/repos","events_url":"https://api.github.com/users/alimd/events{/privacy}","received_events_url":"https://api.github.com/users/alimd/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":25,"created_at":"2023-11-24T21:10:09Z","updated_at":"2025-12-05T20:15:30Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I made a Docker image of this project and update it regularly, but I don't notify about new updates!  \r\nI can't build regularly in my CI/CD and unfortunately we are still using version v1.8.0!\r\nEvery once in a while, I checked this project and saw that there was still no new version (from the last tag) and I thought that this project was abandoned by Telegram and will not continue anymore!  Until today I randomly saw 21 new updates since the last tag that I didn't see and I was shocked!\r\nhttps://github.com/Alwatr/containers/tree/next/tdlib\r\n\r\nCould you please make the tag regularly after every update?\r\n\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/tdlib/td/issues/2696/reactions","total_count":13,"+1":13,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tdlib/td/issues/2696/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/tdlib/td/issues/1112","repository_url":"https://api.github.com/repos/tdlib/td","labels_url":"https://api.github.com/repos/tdlib/td/issues/1112/labels{/name}","comments_url":"https://api.github.com/repos/tdlib/td/issues/1112/comments","events_url":"https://api.github.com/repos/tdlib/td/issues/1112/events","html_url":"https://github.com/tdlib/td/issues/