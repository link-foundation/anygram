{
  "name": "anygram",
  "version": "0.5.0",
  "description": "Unified Telegram APIs with selectable client backends and native protocol support",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./mtproto": {
      "types": "./src/mtproto.d.ts",
      "import": "./src/mtproto.js"
    },
    "./tl": {
      "types": "./src/tl.d.ts",
      "import": "./src/tl.js"
    },
    "./storage": {
      "types": "./src/storage.d.ts",
      "import": "./src/storage.js"
    }
  },
  "scripts": {
    "test": "node --test tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "node experiments/check-duplication-gate.mjs && node --max-old-space-size=384 node_modules/jscpd/bin/jscpd src",
    "check": "npm run lint && npm run format:check && npm run check:duplication && npm run typecheck",
    "prepare": "husky || true",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "schema:update": "node scripts/update-schema.mjs",
    "schema:update:secret": "node scripts/update-secret-schema.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "keywords": [
    "telegram",
    "mtproto",
    "bot-api",
    "gramjs",
    "mtcute",
    "teleproto"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/anygram.git"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@mtcute/core": "0.32.7",
    "@mtcute/tl-runtime": "0.32.6",
    "@mtproto/core": "6.3.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "grammy": "1.46.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "node-telegram-bot-api": "2.1.0",
    "prettier": "3.7.4",
    "telegraf": "4.16.3",
    "telegram": "2.26.22",
    "teleproto": "1.232.0",
    "test-anywhere": "^0.8.48",
    "typescript": "7.0.2",
    "websocket": "1.0.35"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.{md,ts,tsx}": [
      "prettier --write",
      "prettier --check"
    ]
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ]
}
