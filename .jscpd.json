{
  "threshold": 0,
  "minTokens": 30,
  "minLines": 5,
  "skipComments": true,
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.min.js",
    "**/coverage/**",
    "**/docs/case-studies/*/data/**",
    "**/.changeset/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock"
  ],
  "format": ["javascript", "typescript"],
  "maxLines": 1500,
  "maxSize": "128kb",
  "reporters": ["console", "json"],
  "output": "./reports/jscpd"
}
